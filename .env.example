# Bu dosya git'e girer — gerçek değer İÇERMEZ, sadece hangi değişkenlerin
# gerektiğini gösterir. Yerel geliştirme için bu dosyayı `.env` olarak
# kopyalayıp kendi değerlerinizi girin:
#   cp .env.example .env
#
# Production'a taşırken KOD DEĞİŞMEZ — sadece bu değişkenler o ortamın
# (Render/Railway/Azure/AWS/DigitalOcean/VPS) kendi env ayarlarına girilir.

# Django
# Üretmek için: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value
# Production'da mutlaka False olmalı.
DEBUG=True
# Virgülle ayrılmış host listesi, örn: example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
# Nginx/PaaS reverse proxy arkasında HTTPS domain'iniz, örn: https://example.com
CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DATABASE_NAME=billing_engine
DATABASE_USER=billing_engine
DATABASE_PASSWORD=change-me
# docker-compose ile çalışırken servis adı: db
DATABASE_HOST=db
DATABASE_PORT=5432
